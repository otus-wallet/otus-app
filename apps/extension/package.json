{
  "name": "@otus-wallet/extension",
  "private": true,
  "type": "module",
  "description": "Otus's browser wallet: a Chrome extension that reviews every transaction before you sign, on @solana/kit",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs --store && node pack.mjs",
    "verify": "node verify.mjs",
    "watch": "node build.mjs --watch",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@otus-wallet/core": "0.0.0",
    "@otus-wallet/provider": "0.0.0",
    "@otus-wallet/sdk": "0.2.0",
    "@otus-wallet/ui": "0.0.0",
    "@scure/bip39": "2.4.0",
    "@solana-program/compute-budget": "0.19.0",
    "@solana-program/stake": "0.10.0",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/chrome": "0.3.4",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
