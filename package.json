{
  "name": "otus-app",
  "private": true,
  "type": "module",
  "description": "Otus Wallet: a self-custodial Solana wallet that reviews every transaction before it is signed",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @otus-wallet/extension",
    "package": "npm run package -w @otus-wallet/extension",
    "watch": "npm run watch -w @otus-wallet/extension",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
