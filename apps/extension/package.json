{
  "name": "@otus-wallet/extension",
  "private": true,
  "type": "module",
  "description": "Otus's browser wallet: a Chrome extension that reviews every transaction before you sign, on @solana/kit",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs --store && cd dist && rm -f ../otus.zip && zip -qrX ../otus.zip .",
    "watch": "node build.mjs --watch",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@noble/hashes": "2.4.0",
    "@otus-wallet/sdk": "file:../../../otus-sdk",
    "@scure/bip39": "2.4.0",
    "@solana-program/compute-budget": "0.19.0",
    "@solana-program/stake": "0.10.0",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.3.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@tanstack/react-query": "5.104.1",
    "@wallet-standard/base": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "@wallet-standard/wallet": "1.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "qrcode-generator": "2.0.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/chrome": "0.3.4",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  }
}
